<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/btnBack"
                android:text="Back"
                android:textColor="#2D7DD2"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_back"
                android:drawablePadding="4dp"
                android:layout_alignParentStart="true"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvTitle"
                android:text="New Complaint"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111827"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ISSUE DETAILS -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvIssueTitle"
                android:text="Issue Details"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvIssueSubtitle"
                android:text="Please provide details about the issue to help us resolve it faster."
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="6dp"/>

            <!-- CATEGORY -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvCategoryLabel"
                android:text="CATEGORY"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="20dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardCategory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvCategory"
                        android:text="Select Category (Water, Roads, etc.)"
                        android:textColor="#6B7280"
                        android:textSize="14sp"
                        android:layout_alignParentStart="true"/>

                    <ImageView
                        android:id="@+id/icDropdown"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="#6B7280"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- DESCRIPTION -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvDescriptionLabel"
                android:text="DESCRIPTION"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="18dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:hint="Describe the issue in detail..."
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:gravity="top"
                    android:inputType="textMultiLine"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvMinChars"
                android:text="Min. 20 characters"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"/>

            <!-- EVIDENCE -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvEvidenceLabel"
                android:text="EVIDENCE"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="18dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardUpload"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/layoutUpload"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/icCamera"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="12dp"
                        android:src="@drawable/ic_camera"
                        app:tint="#2D7DD2"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvUpload"
                        android:text="Upload Photo"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvUploadSub"
                        android:text="Add a picture of the issue"
                        android:textColor="#6B7280"
                        android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- LOCATION -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvLocationLabel"
                android:text="LOCATION"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="18dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLocation"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/icLocation"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="10dp"
                        android:src="@drawable/ic_location"
                        app:tint="#2D7DD2"/>

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/icLocation"
                        android:layout_marginStart="10dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:id="@+id/tvAddress"
                            android:text="24th Avenue, Sunnyvale, CA"
                            android:textColor="#111827"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:id="@+id/tvLocationSub"
                            android:text="Current Location (Auto-detected)"
                            android:textColor="#6B7280"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/btnEditLocation"
                        android:text="Edit"
                        android:textColor="#2D7DD2"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- PRIVACY NOTE -->
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvPrivacy"
                android:text="Location data is used to route your complaint to the correct service team. Your data is handled according to our Privacy Policy."
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:layout_marginTop="12dp"/>

            <!-- SUBMIT BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitComplaint"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Submit Complaint  >"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_gradient_button"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

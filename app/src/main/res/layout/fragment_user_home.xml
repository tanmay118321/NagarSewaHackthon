<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvAppName"
                    android:text="SmartCity"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#2D7DD2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvPortal"
                    android:text="Citizen Portal"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_circle_white"
                android:padding="10dp"
                android:src="@drawable/ic_bell"
                app:tint="#2D7DD2"/>
        </RelativeLayout>

        <!-- WELCOME CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_blue">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:text="Good Morning"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:id="@+id/tvUsername"
                    android:text="Welcome, Alex"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:id="@+id/tvSubtitle"
                    android:text="How can we help you improve our city today? Report issues or track your contributions."
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- QUICK ACTION TITLE -->
        <TextView
            android:id="@+id/tvQuickActions"
            android:text="QUICK ACTIONS"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ACTION GRID -->
        <GridLayout
            android:id="@+id/gridActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginTop="12dp">

            <!-- Register Complaint -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRegister"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icRegister"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="10dp"
                        android:src="@drawable/ic_megaphone"
                        app:tint="#2D7DD2"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Register Complaint"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="NEW REPORT"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Track Complaint -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTrack"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icTrack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="10dp"
                        android:src="@drawable/ic_clipboard"
                        app:tint="#2D7DD2"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Track Complaint"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvActiveCount"
                        android:text="2 ACTIVE"
                        android:textColor="#2D7DD2"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nearby Issues -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMap"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icMap"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="10dp"
                        android:src="@drawable/ic_map"
                        app:tint="#2D7DD2"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Nearby Issues"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="VIEW MAP"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- AI Chatbot -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardChatbot"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icChatbot"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:padding="10dp"
                        android:src="@drawable/ic_bot"
                        app:tint="#2D7DD2"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="AI Chatbot"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="24/7 SUPPORT"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- RECENT UPDATES TITLE -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvRecent"
                android:text="RECENT UPDATES"
                android:textStyle="bold"
                android:textColor="#6B7280"
                android:textSize="13sp"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvSeeAll"
                android:text="See All"
                android:textColor="#2D7DD2"
                android:textSize="13sp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- RECENT CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRecent"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgRecent"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_issue"
                    app:tint="@color/black" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/imgRecent"
                    android:layout_marginStart="12dp"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvRecentTitle"
                        android:text="Street Light Repaired"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:id="@+id/tvRecentSub"
                        android:text="Oxford Street • Completed"
                        android:textColor="#6B7280"
                        android:textSize="13sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/icArrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#9CA3AF"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

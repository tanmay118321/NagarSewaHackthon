<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAFF">

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:background="@drawable/ic_launcher_background"
                    android:padding="8dp"/>

                <LinearLayout
                    android:id="@+id/headerTextLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUPER ADMIN"
                        android:textSize="12sp"
                        android:textColor="#3F8CFF"/>

                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nagar Sewa"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/ic_notifications"
                    android:background="@drawable/bg_logo_light"
                    android:padding="8dp"/>
            </LinearLayout>

            <!-- Service Overview -->
            <TextView
                android:id="@+id/tvServiceOverviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Overview"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvServiceOverviewSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time complaint monitoring"
                android:textColor="#777"/>

            <!-- Daily Activity -->

            <GridLayout
                android:id="@+id/gridServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false"
                android:padding="4dp">

                <!-- Garbage -->
                <include
                    layout="@layout/item_service_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <!-- Water -->
                <include
                    layout="@layout/item_service_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <!-- Roads -->
                <include
                    layout="@layout/item_service_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

                <!-- Electricity -->
                <include
                    layout="@layout/item_service_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"/>

            </GridLayout>

            <TextView
                android:id="@+id/tvDailyActivityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Activity"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

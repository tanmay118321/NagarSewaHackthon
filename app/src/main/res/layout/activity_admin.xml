<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/profile"
            android:background="@android:color/holo_orange_light"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back,"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar" />

        <TextView
            android:id="@+id/tvDashboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome" />
        <ImageView
            android:id="@+id/ivAnalytics"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_analytics"

            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            app:tint="#425ADB"
            app:layout_constraintTop_toTopOf="@id/tvDashboardTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvDashboardTitle"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/tvSectionNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Complaints"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#222222"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar" />

        <TextView
            android:id="@+id/tvPendingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E1F0FA"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="3 PENDING"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvSectionNew"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSectionNew" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNewComplaints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvSectionNew" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>